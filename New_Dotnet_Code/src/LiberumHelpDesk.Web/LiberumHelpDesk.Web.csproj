<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LiberumHelpDesk.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Ship the SQLite schema/seed scripts and the language files next to the app so the
       DatabaseSeeder (setup.asp replica) can read them at runtime in dev, tests, and Docker. -->
  <ItemGroup>
    <None Update="Data\schema.sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\seed.sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\lang\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
