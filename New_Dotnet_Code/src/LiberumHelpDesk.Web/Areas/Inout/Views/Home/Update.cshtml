@model InoutUpdateVm
@{
    var siteName = (ViewData["SiteName"] as string) ?? "";
    var img = Model.HasImage ? $"/image/{Model.Uid}.jpg" : "/image/nopicture.gif";
}
@* Port of inout/update.asp *@
<div align="center">
  <table class="normal">
    <tr class="Head1"><td>@siteName</td></tr>
    <tr class="Head2" align="center"><td>@Html.Lang("UserDetails")</td></tr>
  </table>
  <table class="inout">
    <form method="POST" action="/Inout/Update?id=@Model.Mid">
      <input type="hidden" name="save" value="1" />
      @if (Model.Saved)
      {
        <tr class="head2"><td colspan="3"><div align="center">@Html.Lang("Information")&nbsp;@Html.Lang("isUpdated")</div></td></tr>
      }
      <tr class="body1">
        <td>@Html.Lang("Fullname")<br /></td>
        <td><b>@Model.Uname</b><br /></td>
        <td rowspan="8" valign="top" align="right"><img src="@img" width="140" height="170" alt="@Model.Uname" border="0" /></td>
      </tr>
      <tr class="body1"><td>@Html.Lang("Department")<br /></td><td><b>@Model.Dname</b><br /></td></tr>
      <tr class="body1"><td>@Html.Lang("Username")</td><td><b>@Model.Uid</b></td></tr>
      <tr class="body1"><td>@Html.Lang("Email")</td><td><b>@Model.Email1</b></td></tr>
      <tr class="body1"><td>@Html.Lang("Phone")</td><td><b>@Model.Phone</b></td></tr>
      <tr class="body1"><td>@Html.Lang("HomePhone")</td><td><input type="text" name="frm_phone_home" value="@Model.PhoneHome" size="10" /></td></tr>
      <tr class="body1"><td>@Html.Lang("MobilePhone")</td><td><input type="text" name="frm_phone_mobile" value="@Model.PhoneMobile" size="10" /></td></tr>
      <tr class="body1"><td>&nbsp;</td><td>&nbsp;</td></tr>
      <tr class="body1"><td valign="top">@Html.Lang("Function")</td><td colspan="2"><textarea name="frm_jobfunction" rows="4" cols="45">@Model.Jobfunction</textarea></td></tr>
      <tr class="body1"><td valign="top">@Html.Lang("Resume")</td><td colspan="2"><textarea name="frm_userresume" rows="4" cols="45">@Model.Userresume</textarea></td></tr>
      <tr class="body1"><td align="center" colspan="3"><input type="submit" value="@Loc.Lang("Submit")" /></td></tr>
    </form>
  </table>
  <form method="post" action="/Inout/SaveFile?uid=@Model.Mid" enctype="multipart/form-data">
    <table class="inout">
      <tr class="Head2" align="center"><td colspan="2">@Html.Lang("Uploadimage")</td></tr>
      <tr class="body1"><td colspan="2">&nbsp;</td></tr>
      <tr class="body1"><td>@Html.Lang("Image")</td><td><input type="file" name="blob" size="40" /></td></tr>
      <tr class="body1" align="center"><td colspan="2"><i>(@Html.Lang("MaxImageSize"):&nbsp;@Model.MaxImageSize&nbsp;@Html.Lang("Bytes"))</i></td></tr>
      <tr class="body1" align="center"><td colspan="2"><input type="submit" value="@Loc.Lang("Upload")" /></td></tr>
      <tr class="body1"><td align="right" colspan="3"><a href="/Inout/Details?id=@Model.Mid">@Html.Lang("Details")</a></td></tr>
    </table>
  </form>
</div>
@Html.Raw(Chrome.Footer())
