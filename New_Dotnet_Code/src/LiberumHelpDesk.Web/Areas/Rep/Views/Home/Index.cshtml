@model RepMenuVm
@* Port of rep/default.asp (rep main menu) *@
@Html.Raw(Chrome.Header())
<div align="center">
  <table Class="Normal">
    <tr class="Head1"><td>@Model.SiteName</td></tr>
    <tr class="Head2"><td><div align="center">@Html.Lang("HelpDesk")</div></td></tr>
    <tr class="Body1"><td align="center"><a href="/Rep/Problem/New">@Html.Lang("SubmitNewProblem")</a></td></tr>
    @if (Model.RepAccess != 2)
    {
      <tr class="Body1"><td align="center"><a href="/Rep/Problem/View">@Html.Lang("ViewProblemList")</a></td></tr>
    }
    <tr class="Body1"><td align="center"><a href="/Rep/Search">@Html.Lang("SearchProblems")</a></td></tr>
    @if (Model.RepAccess != 1)
    {
      <tr class="Body1">
        <td valign="center" align="center">
          <br />
          <form method="post" action="/Rep/Problem/View">
            @Html.Lang("Viewproblemsfor"): <select name="rep_id" onchange="this.form.submit()">
              @foreach (var r in Model.Reps)
              {
                if (r.IsSelf)
                {
                  <option value="@r.Sid" selected>(@r.Count) @r.Uid</option>
                }
                else
                {
                  <option value="@r.Sid">(@r.Count) @r.Uid</option>
                }
              }
            </select>&nbsp;&nbsp;<input type="submit" value="@Loc.Lang("View")" />
          </form>
        </td>
      </tr>
    }
    @if (Model.EnableKB >= 1)
    {
      <tr class="Head2"><td><div align="center">@Html.Lang("KnowledgeBase")</div></td></tr>
      <tr class="Body1"><td><div align="center"><a href="/Kb">@Html.Lang("SearchtheKnowledgeBase")</a></div></td></tr>
      <tr class="Body1">
        <td valign="center">
          <div align="center">
            <br />
            <form method="POST" action="/Kb/Details">
              <input type="text" size="6" name="id" /> <input type="submit" value="@Loc.Lang("LookupbyID")" />
            </form>
          </div>
        </td>
      </tr>
    }
    <tr class="Head2"><td><div align="center">@Html.Lang("Other")</div></td></tr>
    @if (Model.UseInout == 1)
    {
      <tr class="Body1"><td align="center"><a href="/Inout">@Html.Lang("InOutBoard")</a></td></tr>
    }
    <tr class="Body1"><td align="center"><a href="/Register?edit=1">@Html.Lang("EditInformation")</a></td></tr>
  </table>
</div>
@Html.Raw(Chrome.Footer())
