@model RepDetailsVm
@{
    string ro = Model.ReadonlyText ? " readonly" : "";
    string dis = Model.DisabledList ? " disabled" : "";
}
@* Port of rep/details.asp (edit form) *@
<form action="/Rep/Problem/Details" method="POST">
  <input type="hidden" name="uid" value="@Model.Uid" />
  <input type="hidden" name="id" value="@Model.Id" />
  <input type="hidden" name="oldrep" value="@Model.Rep" />
  <input type="hidden" name="update" value="1" />
  <div align="center">
    <table class="Normal">
      <tr>
        <td colspan="2" align="right">
          <em>*</em> = @Html.Lang("Required") |
          <a href="/Rep/Problem/Print?id=@Model.Id" target="printwindow">@Html.Lang("PrinterFriendly")</a>
        </td>
      </tr>
      <tr class="Head1"><td colspan="2">@Html.Lang("EditProblem")&nbsp;@Model.Id</td></tr>
      @if (Model.JustUpdated)
      {
        <tr class="Head2"><td colspan="2"><div align="center">@Html.Raw(Model.UpdateMessage)</div></td></tr>
      }
      <tr class="Body1">
        <td valign="top" width="50%">
          <div align="center">
            <table class="Narrow">
              <tr><td align="center" colspan="2"><b>@Html.Lang("ContactInformation")</b></td></tr>
              <tr><td><b>@Html.Lang("UserName"):</b></td><td><a href="mailto:@(Model.Uemail)?Subject=HELPDESK: Problem @Model.Id">@Model.Uid</a></td></tr>
              <tr><td><b>@Html.Lang("EMail"):</b></td><td><input type="text" name="uemail" size="20" value="@Model.Uemail"@(Html.Raw(ro)) /><em>*</em></td></tr>
              <tr>
                <td><b>@Html.Lang("Department"):</b></td>
                <td>
                  <select name="department"@(Html.Raw(dis))>
                    @foreach (var d in Model.Departments)
                    {
                      @if (d.Id == Model.Department) { <option value="@d.Id" selected>@d.Name</option> } else { <option value="@d.Id">@d.Name</option> }
                    }
                  </select><em>*</em>
                </td>
              </tr>
              <tr><td><b>@Html.Lang("Location"):</b></td><td><input type="text" name="ulocation" size="20" value="@Model.Ulocation"@(Html.Raw(ro)) /></td></tr>
              <tr><td><b>@Html.Lang("Phone"):</b></td><td><input type="text" name="uphone" size="20" value="@Model.Uphone"@(Html.Raw(ro)) /></td></tr>
              <tr><td><b>@Html.Lang("EnteredBy"):</b></td><td>@Model.EnteredByUid</td></tr>
            </table>
          </div>
        </td>
        <td valign="top">
          <table class="Narrow">
            <tr><td align="center" colspan="2"><b>@Html.Lang("Classification")</b></td></tr>
            <tr>
              <td><b>@Html.Lang("Category"):</b></td>
              <td>
                <select name="category"@(Html.Raw(dis))>
                  @foreach (var c in Model.Categories)
                  {
                    @if (c.Id == Model.Category) { <option value="@c.Id" selected>@c.Name</option> } else { <option value="@c.Id">@c.Name</option> }
                  }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("Status"):</b></td>
              <td>
                <select name="status" id="selStatus"@(Html.Raw(dis))>
                  @foreach (var s in Model.Statuses)
                  {
                    @if (s.Id == Model.Status) { <option value="@s.Id" selected>@s.Name</option> } else { <option value="@s.Id">@s.Name</option> }
                  }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("Priority"):</b></td>
              <td>
                <select name="priority"@(Html.Raw(dis))>
                  @foreach (var pr in Model.Priorities)
                  {
                    @if (pr.Id == Model.Priority) { <option value="@pr.Id" selected>@pr.Name</option> } else { <option value="@pr.Id">@pr.Name</option> }
                  }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("AssignTo"):</b></td>
              <td>
                <select name="rep"@(Html.Raw(dis))>
                  @foreach (var rp in Model.Reps)
                  {
                    @if (rp.Id == Model.Rep) { <option value="@rp.Id" selected>@rp.Name</option> } else { <option value="@rp.Id">@rp.Name</option> }
                  }
                </select><em>*</em>
              </td>
            </tr>
            <tr><td><b>@Html.Lang("DueDate"):</b></td><td><input type="text" name="duedate" size="10" maxlength="12" value="@Model.DueDate"@(Html.Raw(ro)) /><em>*</em>&nbsp;<font size="-2">(@Model.DateFormat)</font></td></tr>
            <tr><td><b>@Html.Lang("TimeSpent"):</b></td><td><input type="text" size="4" name="time_spent" value="@Model.TimeSpent"@(Html.Raw(ro)) />(@Html.Lang("minutes"))</td></tr>
            <tr><td><b>@Html.Lang("StartDate"):</b></td><td>@Model.StartDate</td></tr>
            <tr><td><b>@Html.Lang("CloseDate"):</b></td><td>@Model.CloseDate</td></tr>
          </table>
          @if (Model.IsClosed)
          {
            <div align="center"><b><a href="/Rep/Problem/Details?id=@Model.Id&reopen=1">@Html.Lang("ReopenProblem")</a></b></div>
          }
        </td>
      </tr>
      <tr class="Head2"><td colspan="2">@Html.Lang("ProblemInformation"):</td></tr>
      <tr class="Body1">
        <td colspan="2">
          <b>@Html.Lang("Title"):</b><em>*</em><br />
          <input type="text" name="title" size="50" value="@Model.Title"@(Html.Raw(ro)) />
          <p></p>
          <b>@Html.Lang("Description"):</b><br />
          <textarea readonly rows="8" cols="80" name="disp_description">@Model.Description</textarea>
        </td>
      </tr>
      <tr class="Head2"><td colspan="2">@Html.Lang("Notes"):</td></tr>
      <tr class="Body1">
        <td colspan="2">
          @if (Model.Notes.Count == 0)
          {
            @Html.Lang("NoAvailableNotes")
          }
          else
          {
            foreach (var n in Model.Notes)
            {
              <b>[@n.DateDisplay - @n.Uid@(n.Private ? " - PRIVATE" : "")]</b><br />
              @Html.Raw(n.NoteHtml)
              <p></p>
            }
          }
        </td>
      </tr>
      @if (!Model.IsClosed)
      {
        <tr class="Head2"><td colspan="2">@Html.Lang("EnterAdditionalNotes"):</td></tr>
        <tr class="Body1">
          <td colspan="2">
            <textarea rows="8" cols="80" name="notes"@(Html.Raw(ro))></textarea><br />
            <input type="checkbox" name="hidenotes"@(Html.Raw(dis)) />&nbsp;@Html.Lang("HideFromEndUser")
          </td>
        </tr>
      }
      <tr class="Head2"><td colspan="2">@Html.Lang("Solution"):</td></tr>
      <tr class="Body1">
        <td colspan="2">
          <textarea rows="8" cols="80" name="solution"@(Html.Raw(ro))>@Model.Solution</textarea>
          @if (Model.EnableKB != 0)
          {
            if (Model.Kb == 0)
            {
              <input type="checkbox" name="kb"@(Html.Raw(dis)) />
            }
            else
            {
              <input type="checkbox" name="kb" checked@(Html.Raw(dis)) />
            }
            <text>&nbsp;</text>@Html.Lang("EnterinKnowledgeBase")
          }
        </td>
      </tr>
      @if (Model.ShowSave)
      {
        <tr class="Head2" align="center">
          <td colspan="2">
            @if (Model.EmailType != 0)
            {
              <input type="checkbox" name="noemail" id="noEmailCheck" /><label id="noEmailSend" for="noEmailCheck">@Html.Lang("Dontsendemailtouser")</label>
              <p></p>
            }
            <input type="submit" value="@Loc.Lang("SaveProblem")" name="B1" />
          </td>
        </tr>
      }
    </table>
  </div>
</form>
@Html.Raw(Chrome.Footer())
