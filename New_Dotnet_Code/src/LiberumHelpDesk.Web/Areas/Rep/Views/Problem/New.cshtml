@model RepNewVm
@* Port of rep/new.asp (create on behalf, with the select-user popup) *@
<script language="JavaScript">
  function openChild(file, window) {
      childWindow = open(file, window, 'resizable=yes,width=560,height=300');
      if (childWindow.opener == null) childWindow.opener = self;
  }
</script>
<form action="/Rep/Problem/New" method="POST" name="newProbForm">
  <input type="hidden" name="save" value="1" />
  <div align="center">
    <table class="Normal">
      <tr><td colspan="2" align="right"><em>*</em> = @Html.Lang("Required")</td></tr>
      <tr class="Head1"><td colspan="2">@Html.Lang("SubmitANewProblem")</td></tr>
      @if (Model.JustSubmitted)
      {
        <tr class="Head2"><td colspan="2"><div align="center">@Html.Raw(Model.SubmitResults)</div></td></tr>
      }
      <tr class="Body1">
        <td valign="top" align="center" width="50%">
          <table class="narrow" border="0">
            <tr><td align="center" colspan="2"><b>@Html.Lang("ContactInformation")</b></td></tr>
            <tr><td><b>@Html.Lang("UserName"):</b></td><td><input type="text" name="uid" size="20" /><em>*</em></td></tr>
            <tr><td><b>@Html.Lang("EMail"):</b></td><td><input type="text" name="uemail" size="20" value="@Model.BaseEmail" /><em>*</em></td></tr>
            <tr>
              <td><b>@Html.Lang("Department"):</b></td>
              <td>
                <select name="department">
                  <option value="0" selected>@Html.Lang("SelectDepartment")</option>
                  @foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }
                </select><em>*</em>
              </td>
            </tr>
            <tr><td><b>@Html.Lang("Location"):</b></td><td><input type="text" name="ulocation" size="20" /></td></tr>
            <tr><td><b>@Html.Lang("Phone"):</b></td><td><input type="text" name="uphone" size="20" /></td></tr>
            @if (Model.UseSelectUser)
            {
              <tr><td colspan="2"><div align="center"><b>--- @Html.Lang("Or") ---</b></div></td></tr>
              <tr>
                <td><b><a href="javascript:void(0)" onclick="openChild('/Rep/SelectUser','userselect');">@Html.Lang("SelectUser")</a>: </b></td>
                <td>
                  <input type="hidden" name="uselectid" value="0" />
                  <div id="selectUserText"></div>
                </td>
              </tr>
            }
            else
            {
              <input type="hidden" name="uselectid" value="0" />
            }
          </table>
        </td>
        <td valign="top">
          <table class="narrow" border="0">
            <tr><td align="center" colspan="2"><b>@Html.Lang("Classification")</b></td></tr>
            <tr>
              <td><b>@Html.Lang("Category"):</b></td>
              <td>
                <select name="category">
                  <option value="0" selected>@Html.Lang("SelectCategory")</option>
                  @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("Status"):</b></td>
              <td>
                <select name="status">
                  @foreach (var s in Model.Statuses) { if (s.Id == Model.DefaultStatus) { <option value="@s.Id" selected>@s.Name</option> } else { <option value="@s.Id">@s.Name</option> } }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("Priority"):</b></td>
              <td>
                <select name="priority">
                  @foreach (var pr in Model.Priorities) { if (pr.Id == Model.DefaultPriority) { <option value="@pr.Id" selected>@pr.Name</option> } else { <option value="@pr.Id">@pr.Name</option> } }
                </select><em>*</em>
              </td>
            </tr>
            <tr>
              <td><b>@Html.Lang("AssignTo"):</b></td>
              <td>
                <select name="rep">
                  @foreach (var rp in Model.Reps) { if (rp.Id == Model.SelfSid) { <option value="@rp.Id" selected>@rp.Name</option> } else { <option value="@rp.Id">@rp.Name</option> } }
                </select><em>*</em>
              </td>
            </tr>
            <tr><td><b>@Html.Lang("DueDate"):</b></td><td><input type="text" name="duedate" size="10" maxlength="12" value="@Model.DueDate" /><em>*</em>&nbsp;<font size="-2">(@Model.DateFormat)</font></td></tr>
            <tr><td><b>@Html.Lang("TimeSpent"):</b></td><td><input type="text" size="4" name="time_spent" value="0" />(@Html.Lang("minutes"))</td></tr>
          </table>
        </td>
      </tr>
      <tr class="Head2"><td colspan="2">@Html.Lang("ProblemInformation"):</td></tr>
      <tr class="Body1">
        <td colspan="2">
          <b>@Html.Lang("Title"):</b><em>*</em><br />
          <input type="text" name="title" size="50" />
          <p></p>
          <b>@Html.Lang("Description"):</b><em>*</em><br />
          <textarea rows="8" cols="80" name="description"></textarea>
        </td>
      </tr>
      <tr class="Head2"><td colspan="2">@Html.Lang("Solution"):</td></tr>
      <tr class="Body1">
        <td colspan="2">
          <textarea rows="8" cols="80" name="solution"></textarea>
          @if (Model.EnableKB != 0)
          {
            <text><input type="checkbox" name="kb" />&nbsp;@Html.Lang("EnterinKnowledgeBase")</text>
          }
        </td>
      </tr>
      <tr class="Head2">
        <td colspan="2" align="center">
          @if (Model.EmailType != 0)
          {
            <text><input type="checkbox" name="noemail" />&nbsp;@Html.Lang("Dontsendemailtouser")</text>
          }
          <p></p>
          <input type="submit" value="@Loc.Lang("SubmitProblem")" name="B1" />&nbsp;<input type="reset" value="@Loc.Lang("ClearForm")" name="B2" />
        </td>
      </tr>
    </table>
  </div>
</form>
@Html.Raw(Chrome.Footer())
